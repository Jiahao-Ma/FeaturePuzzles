# =============================================================
# FeaturePuzzles .gitignore
# Keep source code, scripts and markdown. Exclude datasets,
# checkpoints, rendered results and third-party clones.
# =============================================================

# ---- Python build / cache ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Notebook checkpoints / autosaves ----
.ipynb_checkpoints/
*.ipynb~

# ---- Editor / IDE ----
.vscode/
.idea/
.cursor/
*.swp
*.swo

# ---- Environment / OS ----
.env
.venv/
venv/
env/
.DS_Store
Thumbs.db

# =============================================================
# Heavy data we never want in git (per project policy)
# =============================================================

# Model checkpoints / training artifacts
checkpoints/
weights/
output/
outputs/
runs/
wandb/
logs/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.npz
*.npy

# Datasets. The download scripts that fetch them are kept.
data/*
!data/*.sh

# Third-party repos cloned into the workspace
repo/
puzzles/
TrainingFreeVGGTMatching/FastVGGT/

# ---- Compiled extensions ----
*.so
*.dylib

# ---- Rendered results and media ----
# Every video and log in this tree is generated by a pipeline run.
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.log

# ICLR26Demo holds one directory per experiment, each mixing its source with
# the frames, point clouds, render configs and comparison figures that running
# it produced. Keep the source; drop everything a run wrote.
ICLR26Demo/**/*.png
ICLR26Demo/**/*.jpg
ICLR26Demo/**/*.jpeg
ICLR26Demo/**/*.csv
# Render presets that ship with the code live in the lingbot-map checkout; every
# yaml here was written out beside a result.
ICLR26Demo/**/*.yaml
ICLR26Demo/**/materials/
ICLR26Demo/vggt_omega_multiprompt_static_scene/scene*/
ICLR26Demo/vggt_omega_multiprompt_static_scene/eval_*/
ICLR26Demo/vggt_omega_multiprompt_dynamic_scene/*/
# Absolute symlinks into this machine's dataset copy.
ICLR26Demo/vggt_omega_multiprompt_static_scene/_depth_process_scenes/

# FeaturePuzzlesPipline outputs and weights (generated per run)
ICLR2027/FeaturePuzzlesPipline/outputs/
ICLR2027/FeaturePuzzlesPipline/weights/
ICLR2027/FeaturePuzzlesPipline/.pytest_cache/
ICLR2027/FeaturePuzzlesPipline/**/room*.png
ICLR2027/FeaturePuzzlesPipline/**/street.png

# Demo bundle outputs (generated by the SAM3 promptable pipeline)
demo_sam3_promptable/outputs/
demo_openvocab_instance/outputs/

# Demo example assets (large)
TrainingFreeVGGTMatching/examples/

# Pretrained weights pulled by the prompt_matching pipeline
TrainingFreeVGGTMatching/prompt_matching/weights/

# All generated puzzle data + per-run outputs (image data, training records)
TrainingFreeVGGTMatching/compare_prompt_token_data/
TrainingFreeVGGTMatching/compare_prompt_token_outputs/
TrainingFreeVGGTMatching/infer_prompt_matching_data/
TrainingFreeVGGTMatching/infer_prompt_matching_outputs/
TrainingFreeVGGTMatching/prompt_matching_data/
TrainingFreeVGGTMatching/prompt_matching_outputs/
TrainingFreeVGGTMatching/prompt_matching_outputs_*/

# Catch-all for any future *_data / *_outputs directories
**/prompt_matching_data/
**/prompt_matching_outputs*/
**/compare_prompt_token_data/
**/compare_prompt_token_outputs/
**/infer_prompt_matching_data/
**/infer_prompt_matching_outputs/
